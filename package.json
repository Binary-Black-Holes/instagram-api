{
  "name": "@binary-black-holes/instagram-api",
  "version": "0.2.0",
  "description": "Type-safe, class-oriented Instagram Graph API integration module",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "instagram",
    "instagram-api",
    "instagram-graph-api",
    "meta",
    "oauth",
    "social-media",
    "typescript"
  ],
  "author": "hrustalq",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binary-Black-Holes/instagram-api.git"
  },
  "bugs": {
    "url": "https://github.com/Binary-Black-Holes/instagram-api/issues"
  },
  "homepage": "https://github.com/Binary-Black-Holes/instagram-api#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "query-string": "^9.4.0"
  }
}
